# All fixtures are generated here. The independent Go reader decodes every
# output pixel and checks color data and the private metadata block.
env GOTRACEBACK=none
exec go build -o bin/imageproof proof.go
exec bin/imageproof make
chmod 755 bin/vips

# spec: preview smaller format pixels privacy profile png-color alpha quality publication staging
symlink photo.shrunk.png.tmp -> photo.png
protect photo.png photo.shrunk.png.tmp
predicts ncly image shrink photo.png
reads -case 'Keeps private data of the input' -private 'Ana Lima' photo.shrunk.png reference photo.png bin/imageproof match photo.png '{}'
reads -case 'Keeps data that a reader needs' -private 'Montreal 45.5019' photo.shrunk.png reference photo.png bin/imageproof match photo.png '{}'
reads -case 'Loses data that changes the meaning' photo.shrunk.png reference photo.png bin/imageproof match photo.png '{}'
exec bin/imageproof clean
# R1-F3: same valid ICC, gamma and privacy, but corrupt 1008 of 2048 pixels.
# spec: pixels
exec bin/imageproof bad-pixels photo.shrunk.png bad-fidelity.png
reads photo.shrunk.png reference bad-fidelity.png bin/imageproof match photo.png '{}' 64
# Display/profile controls have correct pixels and no private block.
# spec: pixels profile png-color invalid-result
exec bin/imageproof corrupt-display photo.shrunk.png bad-profile-output.png profile
reads photo.shrunk.png reference bad-profile-output.png bin/imageproof match photo.png '{}'
exec bin/imageproof corrupt-display photo.shrunk.png bad-gamma-output.png gamma
reads photo.shrunk.png reference bad-gamma-output.png bin/imageproof match photo.png '{}'


# The exact manifest example proves real byte saving and removal of its XMP.
# spec: pixels format smaller privacy profile alpha
ncly image shrink example.webp --json
reads example.shrunk.webp reference example.webp bin/imageproof match example.webp '{}'

# R1-F1: entire display-declaration family, not a single privacy payload.
# spec: privacy input-invalid png-color
exec bin/imageproof declarations
ncly image shrink valid-gAMA.png --json
exec bin/imageproof fixture valid-gAMA.png valid-gAMA.shrunk.png
protect length-gAMA.png length-gAMA.shrunk.png
refuses IMAGE_SHRINK_INPUT ncly image shrink length-gAMA.png
protect duplicate-gAMA.png duplicate-gAMA.shrunk.png
refuses IMAGE_SHRINK_INPUT ncly image shrink duplicate-gAMA.png
protect value-gAMA.png value-gAMA.shrunk.png
refuses IMAGE_SHRINK_INPUT ncly image shrink value-gAMA.png
ncly image shrink valid-cHRM.png --json
exec bin/imageproof fixture valid-cHRM.png valid-cHRM.shrunk.png
protect length-cHRM.png length-cHRM.shrunk.png
refuses IMAGE_SHRINK_INPUT ncly image shrink length-cHRM.png
protect duplicate-cHRM.png duplicate-cHRM.shrunk.png
refuses IMAGE_SHRINK_INPUT ncly image shrink duplicate-cHRM.png
protect value-cHRM.png value-cHRM.shrunk.png
refuses IMAGE_SHRINK_INPUT ncly image shrink value-cHRM.png
ncly image shrink valid-sRGB.png --json
exec bin/imageproof fixture valid-sRGB.png valid-sRGB.shrunk.png
protect length-sRGB.png length-sRGB.shrunk.png
refuses IMAGE_SHRINK_INPUT ncly image shrink length-sRGB.png
protect duplicate-sRGB.png duplicate-sRGB.shrunk.png
refuses IMAGE_SHRINK_INPUT ncly image shrink duplicate-sRGB.png
protect value-sRGB.png value-sRGB.shrunk.png
refuses IMAGE_SHRINK_INPUT ncly image shrink value-sRGB.png
ncly image shrink valid-cICP.png --json
exec bin/imageproof fixture valid-cICP.png valid-cICP.shrunk.png
protect length-cICP.png length-cICP.shrunk.png
refuses IMAGE_SHRINK_INPUT ncly image shrink length-cICP.png
protect duplicate-cICP.png duplicate-cICP.shrunk.png
refuses IMAGE_SHRINK_INPUT ncly image shrink duplicate-cICP.png
protect value-cICP.png value-cICP.shrunk.png
refuses IMAGE_SHRINK_INPUT ncly image shrink value-cICP.png
protect conflict-gamma.png conflict-gamma.shrunk.png
refuses IMAGE_SHRINK_INPUT ncly image shrink conflict-gamma.png
protect conflict-chroma.png conflict-chroma.shrunk.png
refuses IMAGE_SHRINK_INPUT ncly image shrink conflict-chroma.png
! exec bin/imageproof fixture valid-gAMA.png leaking-output.png
stderr 'invalid PNG display declaration'
# EXIF is allowed after IDAT, but repeated orientation declarations are not.
exec bin/imageproof exif-placement
ncly image shrink exif-after-pixels.png --json
exec bin/imageproof match exif-after-pixels.png exif-after-pixels.shrunk.png
protect exif-duplicate.png exif-duplicate.shrunk.png
refuses IMAGE_SHRINK_INPUT ncly image shrink exif-duplicate.png

# R1-F2: preserve Gray, Gray-alpha and CMYK sample models and profiles.
# spec: profile orientation pixels alpha depth
exec bin/imageproof model-fixtures
exec vips rawload gray-8-false.raw gray-8-false.v 64 32 1 --interpretation b-w
exec vips copy gray-8-false.v gray-8-false.png
exec bin/imageproof attach-model gray-8-false.png GRAY 2
ncly image shrink gray-8-false.png --json
exec bin/imageproof fixture gray-8-false.png gray-8-false.shrunk.png
rm gray-8-false.shrunk.png
ncly image shrink gray-8-false.png --max-side 32 --json
exec bin/imageproof fixture gray-8-false.png gray-8-false.shrunk.png 32
exec vips rawload gray-8-true.raw gray-8-true.v 64 32 2 --interpretation b-w
exec vips copy gray-8-true.v gray-8-true.png
exec bin/imageproof attach-model gray-8-true.png GRAY 2
ncly image shrink gray-8-true.png --json
exec bin/imageproof fixture gray-8-true.png gray-8-true.shrunk.png
rm gray-8-true.shrunk.png
ncly image shrink gray-8-true.png --max-side 32 --json
exec bin/imageproof fixture gray-8-true.png gray-8-true.shrunk.png 32
exec vips rawload gray-16-false.raw gray-16-false.v 64 32 1 --interpretation b-w --format ushort
exec vips copy gray-16-false.v gray-16-false.png
exec bin/imageproof attach-model gray-16-false.png GRAY 2
ncly image shrink gray-16-false.png --json
exec bin/imageproof fixture gray-16-false.png gray-16-false.shrunk.png
rm gray-16-false.shrunk.png
ncly image shrink gray-16-false.png --max-side 32 --json
exec bin/imageproof fixture gray-16-false.png gray-16-false.shrunk.png 32
exec vips rawload gray-16-true.raw gray-16-true.v 64 32 2 --interpretation b-w --format ushort
exec vips copy gray-16-true.v gray-16-true.png
exec bin/imageproof attach-model gray-16-true.png GRAY 2
ncly image shrink gray-16-true.png --json
exec bin/imageproof fixture gray-16-true.png gray-16-true.shrunk.png
rm gray-16-true.shrunk.png
ncly image shrink gray-16-true.png --max-side 32 --json
exec bin/imageproof fixture gray-16-true.png gray-16-true.shrunk.png 32
exec vips rawload cmyk.raw cmyk.v 64 32 4 --interpretation cmyk
exec vips copy cmyk.v 'cmyk.jpg[Q=100,keep=none]'
exec bin/imageproof attach-model cmyk.jpg CMYK 6
ncly image shrink cmyk.jpg --json
exec bin/imageproof fixture cmyk.jpg cmyk.shrunk.jpg
rm cmyk.shrunk.jpg
ncly image shrink cmyk.jpg --max-side 32 --json
exec bin/imageproof fixture cmyk.jpg cmyk.shrunk.jpg 32

# spec: input-invalid profile
cp gray-8-false.png bad-profile-mismatch.png
exec bin/imageproof bad-model bad-profile-mismatch.png mismatch
protect bad-profile-mismatch.png bad-profile-mismatch.shrunk.png
refuses IMAGE_SHRINK_INPUT ncly image shrink bad-profile-mismatch.png
cp gray-8-false.png bad-profile-truncated.png
exec bin/imageproof bad-model bad-profile-truncated.png truncated
protect bad-profile-truncated.png bad-profile-truncated.shrunk.png
refuses IMAGE_SHRINK_INPUT ncly image shrink bad-profile-truncated.png
cp gray-8-false.png bad-profile-size.png
exec bin/imageproof bad-model bad-profile-size.png size
protect bad-profile-size.png bad-profile-size.shrunk.png
refuses IMAGE_SHRINK_INPUT ncly image shrink bad-profile-size.png
cp gray-8-false.png bad-profile-tag.png
exec bin/imageproof bad-model bad-profile-tag.png tag
protect bad-profile-tag.png bad-profile-tag.shrunk.png
refuses IMAGE_SHRINK_INPUT ncly image shrink bad-profile-tag.png
cp cmyk.jpg bad-profile-mismatch.jpg
exec bin/imageproof bad-model bad-profile-mismatch.jpg mismatch
protect bad-profile-mismatch.jpg bad-profile-mismatch.shrunk.jpg
refuses IMAGE_SHRINK_INPUT ncly image shrink bad-profile-mismatch.jpg
cp cmyk.jpg bad-profile-truncated.jpg
exec bin/imageproof bad-model bad-profile-truncated.jpg truncated
protect bad-profile-truncated.jpg bad-profile-truncated.shrunk.jpg
refuses IMAGE_SHRINK_INPUT ncly image shrink bad-profile-truncated.jpg
cp cmyk.jpg bad-profile-size.jpg
exec bin/imageproof bad-model bad-profile-size.jpg size
protect bad-profile-size.jpg bad-profile-size.shrunk.jpg
refuses IMAGE_SHRINK_INPUT ncly image shrink bad-profile-size.jpg
cp cmyk.jpg bad-profile-tag.jpg
exec bin/imageproof bad-model bad-profile-tag.jpg tag
protect bad-profile-tag.jpg bad-profile-tag.shrunk.jpg
refuses IMAGE_SHRINK_INPUT ncly image shrink bad-profile-tag.jpg

# spec: profile pixels orientation
exec bin/imageproof gray-jpeg
ncly image shrink gray.jpg --max-side 32 --json
exec bin/imageproof match gray.jpg gray.shrunk.jpg 32

# All retained JPEG display declaration shapes have accepted/refused pairs.
# spec: input-invalid profile pixels privacy
exec vips copy orientation-1.jpg 'rgb444.jpg[Q=100,subsample_mode=off,keep=icc]'
exec bin/imageproof jpeg-declarations
ncly image shrink adobe-rgb-0.jpg --json
exec bin/imageproof match adobe-rgb-0.jpg adobe-rgb-0.shrunk.jpg
ncly image shrink adobe-rgb-1.jpg --json
exec bin/imageproof match adobe-rgb-1.jpg adobe-rgb-1.shrunk.jpg
protect adobe-rgb-length.jpg adobe-rgb-length.shrunk.jpg
refuses IMAGE_SHRINK_INPUT ncly image shrink adobe-rgb-length.jpg
protect adobe-rgb-duplicate.jpg adobe-rgb-duplicate.shrunk.jpg
refuses IMAGE_SHRINK_INPUT ncly image shrink adobe-rgb-duplicate.jpg
protect adobe-rgb-value.jpg adobe-rgb-value.shrunk.jpg
refuses IMAGE_SHRINK_INPUT ncly image shrink adobe-rgb-value.jpg
protect adobe-rgb-conflict.jpg adobe-rgb-conflict.shrunk.jpg
refuses IMAGE_SHRINK_INPUT ncly image shrink adobe-rgb-conflict.jpg
ncly image shrink adobe-cmyk-0.jpg --json
exec bin/imageproof match adobe-cmyk-0.jpg adobe-cmyk-0.shrunk.jpg
ncly image shrink adobe-cmyk-2.jpg --json
exec bin/imageproof match adobe-cmyk-2.jpg adobe-cmyk-2.shrunk.jpg
protect adobe-cmyk-length.jpg adobe-cmyk-length.shrunk.jpg
refuses IMAGE_SHRINK_INPUT ncly image shrink adobe-cmyk-length.jpg
protect adobe-cmyk-duplicate.jpg adobe-cmyk-duplicate.shrunk.jpg
refuses IMAGE_SHRINK_INPUT ncly image shrink adobe-cmyk-duplicate.jpg
protect adobe-cmyk-value.jpg adobe-cmyk-value.shrunk.jpg
refuses IMAGE_SHRINK_INPUT ncly image shrink adobe-cmyk-value.jpg
protect adobe-cmyk-conflict.jpg adobe-cmyk-conflict.shrunk.jpg
refuses IMAGE_SHRINK_INPUT ncly image shrink adobe-cmyk-conflict.jpg
ncly image shrink jfif-valid.jpg --json
exec bin/imageproof match jfif-valid.jpg jfif-valid.shrunk.jpg
protect jfif-length.jpg jfif-length.shrunk.jpg
refuses IMAGE_SHRINK_INPUT ncly image shrink jfif-length.jpg
protect jfif-value.jpg jfif-value.shrunk.jpg
refuses IMAGE_SHRINK_INPUT ncly image shrink jfif-value.jpg

# spec: exists
protect photo.png photo.shrunk.png
refuses IMAGE_SHRINK_EXISTS ncly image shrink photo.png

# spec: replace
protect photo.png
chmod 640 photo.shrunk.png
predicts ncly image shrink photo.png --force
exec bin/imageproof mode photo.shrunk.png 640
reads -case 'Exists, without --force' photo.shrunk.png reference photo.png bin/imageproof match photo.png '{}'

# All eight orientations carry a real TIFF orientation entry, ICC profile,
# private comment and non-symmetric colored quadrants.
# spec: orientation profile format pixels privacy
ncly image shrink orientation-1.jpg --json
reads orientation-1.shrunk.jpg reference orientation-1.jpg bin/imageproof match orientation-1.jpg '{}'
ncly image shrink orientation-2.jpg --json
reads orientation-2.shrunk.jpg reference orientation-2.jpg bin/imageproof match orientation-2.jpg '{}'
ncly image shrink orientation-3.jpg --json
reads orientation-3.shrunk.jpg reference orientation-3.jpg bin/imageproof match orientation-3.jpg '{}'
ncly image shrink orientation-4.jpg --json
reads orientation-4.shrunk.jpg reference orientation-4.jpg bin/imageproof match orientation-4.jpg '{}'
ncly image shrink orientation-5.jpg --json
reads orientation-5.shrunk.jpg reference orientation-5.jpg bin/imageproof match orientation-5.jpg '{}'
ncly image shrink orientation-6.jpg --json
reads orientation-6.shrunk.jpg reference orientation-6.jpg bin/imageproof match orientation-6.jpg '{}'
ncly image shrink orientation-7.jpg --json
reads orientation-7.shrunk.jpg reference orientation-7.jpg bin/imageproof match orientation-7.jpg '{}'
ncly image shrink orientation-8.jpg --json
reads orientation-8.shrunk.jpg reference orientation-8.jpg bin/imageproof match orientation-8.jpg '{}'

# The native PNG orientation path preserves unassociated alpha samples.
# spec: orientation pixels alpha
ncly image shrink png-orientation-1.png --json
reads png-orientation-1.shrunk.png reference png-orientation-1.png bin/imageproof match png-orientation-1.png '{}'
ncly image shrink png-orientation-2.png --json
reads png-orientation-2.shrunk.png reference png-orientation-2.png bin/imageproof match png-orientation-2.png '{}'
ncly image shrink png-orientation-3.png --json
reads png-orientation-3.shrunk.png reference png-orientation-3.png bin/imageproof match png-orientation-3.png '{}'
ncly image shrink png-orientation-4.png --json
reads png-orientation-4.shrunk.png reference png-orientation-4.png bin/imageproof match png-orientation-4.png '{}'
ncly image shrink png-orientation-5.png --json
reads png-orientation-5.shrunk.png reference png-orientation-5.png bin/imageproof match png-orientation-5.png '{}'
ncly image shrink png-orientation-6.png --json
reads png-orientation-6.shrunk.png reference png-orientation-6.png bin/imageproof match png-orientation-6.png '{}'
ncly image shrink png-orientation-7.png --json
reads png-orientation-7.shrunk.png reference png-orientation-7.png bin/imageproof match png-orientation-7.png '{}'
ncly image shrink png-orientation-8.png --json
reads png-orientation-8.shrunk.png reference png-orientation-8.png bin/imageproof match png-orientation-8.png '{}'

# Independent display-declaration cases without ICC overriding them.
# spec: png-color pixels privacy
ncly image shrink chroma.png --json
reads chroma.shrunk.png reference chroma.png bin/imageproof match chroma.png '{}'
ncly image shrink srgb.png --json
reads srgb.shrunk.png reference srgb.png bin/imageproof match srgb.png '{}'

# spec: depth
ncly image shrink deep.png --quality 1 --json
reads deep.shrunk.png reference deep.png bin/imageproof match deep.png '{}'

# A lossless WebP fixture is generated with vips; Go's separate WebP decoder
# compares the lossy copy to the declared original quadrants and ICC bytes.
exec vips copy photo.png 'photo.webp[lossless,keep=icc]'
exec bin/imageproof private-webp photo.webp
# spec: alpha format quality pixels profile
ncly image shrink photo.webp --json
reads photo.shrunk.webp reference photo.webp bin/imageproof match photo.webp '{}'

# spec: orientation profile alpha pixels
exec bin/imageproof webp-orientations
ncly image shrink webp-orientation-1.webp --json
exec bin/imageproof match webp-orientation-1.webp webp-orientation-1.shrunk.webp
ncly image shrink webp-orientation-2.webp --json
exec bin/imageproof match webp-orientation-2.webp webp-orientation-2.shrunk.webp
ncly image shrink webp-orientation-3.webp --json
exec bin/imageproof match webp-orientation-3.webp webp-orientation-3.shrunk.webp
ncly image shrink webp-orientation-4.webp --json
exec bin/imageproof match webp-orientation-4.webp webp-orientation-4.shrunk.webp
ncly image shrink webp-orientation-5.webp --json
exec bin/imageproof match webp-orientation-5.webp webp-orientation-5.shrunk.webp
ncly image shrink webp-orientation-6.webp --json
exec bin/imageproof match webp-orientation-6.webp webp-orientation-6.shrunk.webp
ncly image shrink webp-orientation-7.webp --json
exec bin/imageproof match webp-orientation-7.webp webp-orientation-7.shrunk.webp
ncly image shrink webp-orientation-8.webp --json
exec bin/imageproof match webp-orientation-8.webp webp-orientation-8.shrunk.webp

# R1-F4: genuine multi-image files and every multipart classifier.
# spec: multipart format
exec bin/imageproof multipart-fixtures
stdout 'generated APNG and WebP frame sequences'
protect two-frames.png two-frames.shrunk.png
refuses IMAGE_SHRINK_MULTIPART ncly image shrink two-frames.png
protect two-frames.webp two-frames.shrunk.webp
refuses IMAGE_SHRINK_MULTIPART ncly image shrink two-frames.webp
protect animation-chunks.webp animation-chunks.shrunk.webp
refuses IMAGE_SHRINK_MULTIPART ncly image shrink animation-chunks.webp
protect animation-flag.webp animation-flag.shrunk.webp
refuses IMAGE_SHRINK_MULTIPART ncly image shrink animation-flag.webp
protect two-pictures.jpg two-pictures.shrunk.jpg
refuses IMAGE_SHRINK_MULTIPART ncly image shrink two-pictures.jpg
protect mp-index.jpg mp-index.shrunk.jpg
refuses IMAGE_SHRINK_MULTIPART ncly image shrink mp-index.jpg
protect concatenated.jpg concatenated.shrunk.jpg
refuses IMAGE_SHRINK_MULTIPART ncly image shrink concatenated.jpg
# R1-F5: full decoded content must distinguish successful quality choices.
# spec: quality options pixels privacy
exec bin/imageproof quality-fixture
exec vips copy quality.png 'quality.jpg[Q=100,keep=none]'
exec bin/imageproof pad-jpeg quality.jpg
exec vips copy quality.png 'quality.webp[lossless,keep=none]'
exec bin/imageproof private-webp quality.webp
ncly image shrink quality.jpg --quality 20 --json
cp quality.shrunk.jpg quality-low.jpg
ncly image shrink quality.jpg --quality 95 --force --json
exec bin/imageproof quality-pair quality.jpg quality-low.jpg quality.shrunk.jpg
stdout 'higher quality is closer and larger'
! exec bin/imageproof quality-pair quality.jpg quality.shrunk.jpg quality.shrunk.jpg
stderr 'quality override is ineffective'
ncly image shrink quality.webp --quality 20 --json
cp quality.shrunk.webp quality-low.webp
ncly image shrink quality.webp --quality 95 --force --json
exec bin/imageproof quality-pair quality.webp quality-low.webp quality.shrunk.webp
stdout 'higher quality is closer and larger'
! exec bin/imageproof quality-pair quality.webp quality.shrunk.webp quality.shrunk.webp
stderr 'quality override is ineffective'
exits 2 ncly image shrink quality.jpg --quality 0 --json


# spec: geometry
ncly image shrink large.png --json
reads large.shrunk.png reference large.png bin/imageproof match large.png '{}' 2048
rm large.shrunk.png
ncly image shrink large.png --max-side 64 --json
reads large.shrunk.png reference large.png bin/imageproof match large.png '{}' 64

# spec: not-smaller
protect tiny.png tiny.shrunk.png
keeps 2 ncly image shrink tiny.png
stderr '"code":"IMAGE_SHRINK_NOT_SMALLER"'
! exists tiny.shrunk.png

# spec: input-invalid
exec bin/imageproof header
exec bin/imageproof animated
exec bin/imageproof huge
cp photo.png unreadable.png
cp unreadable.png readable-reference.png
chmod 000 unreadable.png
protect missing.png empty.png broken.png
refuses IMAGE_SHRINK_INPUT ncly image shrink missing.png
refuses IMAGE_SHRINK_INPUT ncly image shrink empty.png
refuses IMAGE_SHRINK_INPUT ncly image shrink broken.png
# Explicit accommodation for pascalandy/nicely#497: protect cannot hash a
# mode-000 file. Once fixed, remove the manual reference, mode check,
# restoration and cmp, and use protect unreadable.png again.
protect unreadable.shrunk.png
refuses IMAGE_SHRINK_INPUT ncly image shrink unreadable.png
exec bin/imageproof mode unreadable.png 0
chmod 600 unreadable.png
cmp unreadable.png readable-reference.png

# spec: unsupported
protect wrong.png wrong.gif wrong.jpg
refuses IMAGE_SHRINK_FORMAT ncly image shrink wrong.png
refuses IMAGE_SHRINK_FORMAT ncly image shrink wrong.gif
cp photo.png wrong.jpg
refuses IMAGE_SHRINK_FORMAT ncly image shrink wrong.jpg

# spec: budget
protect expansion.png expansion-pixels.png huge.png
refuses IMAGE_SHRINK_LIMIT ncly image shrink expansion.png
refuses IMAGE_SHRINK_LIMIT ncly image shrink expansion-pixels.png
refuses IMAGE_SHRINK_LIMIT ncly image shrink huge.png

# spec: multipart
protect animated.png
refuses IMAGE_SHRINK_MULTIPART ncly image shrink animated.png

# spec: options
exits 2 ncly image shrink photo.png --max-side 0 --json
exits 2 ncly image shrink photo.png --quality 101 --json
exits 2 ncly image shrink photo.png --timeout soon --json
exits 2 ncly image shrink photo.png --timeout 31s --json

# spec: output-link
rm photo.shrunk.png
symlink photo.shrunk.png -> photo.png
protect photo.png photo.shrunk.png
refuses IMAGE_SHRINK_OUTPUT ncly image shrink photo.png
refuses IMAGE_SHRINK_OUTPUT ncly image shrink photo.png --force
rm photo.shrunk.png
ncly image shrink photo.png --json
reads -case 'Is a link to the input' photo.shrunk.png reference photo.png bin/imageproof match photo.png '{}'
rm photo.shrunk.png
exec ln photo.png photo.shrunk.png
protect photo.png photo.shrunk.png
refuses IMAGE_SHRINK_OUTPUT ncly image shrink photo.png --force
rm photo.shrunk.png

# spec: names
cp photo.png 'my photo;$(date)[x].PNG'
ncly image shrink 'my photo;$(date)[x].PNG' --json
reads 'my photo;$(date)[x].shrunk.PNG' reference photo.png bin/imageproof match photo.png '{}'
cp photo.png -photo.png
ncly image shrink -- -photo.png
reads ./-photo.shrunk.png reference photo.png bin/imageproof match photo.png '{}'

# spec: staging publication
protect photo.png
env STUB=hold
holds marker photo.shrunk.png ncly image shrink photo.png
reads -case 'Temporary file' photo.shrunk.png reference photo.png bin/imageproof match photo.png '{}'
rm photo.shrunk.png

# spec: race
env STUB=appears
protect photo.png
appears marker photo.shrunk.png ncly image shrink photo.png
rm marker
rm photo.shrunk.png

# spec: worker-fails
env STUB=fail
protect photo.png photo.shrunk.png
keeps 1 ncly image shrink photo.png
stderr '"code":"RUNTIME"'
env STUB=noisy
protect photo.png
keeps 0 ncly image shrink photo.png
env STUB=fail
protect photo.png photo.shrunk.png
keeps 1 ncly image shrink photo.png --force
rm photo.shrunk.png
env STUB=hang
protect photo.png photo.shrunk.png
keeps 1 ncly image shrink photo.png --timeout 100ms
stderr '"code":"RUNTIME"'
rm marker

# spec: interrupted
env STUB=hang
protect photo.png photo.shrunk.png
signal INT marker ncly image shrink photo.png
stderr '"code":"INTERRUPTED"'
exec bin/imageproof clean
rm marker

# spec: terminated
cp photo.png photo.shrunk.png
env STUB=hang
protect photo.png photo.shrunk.png
signal TERM marker ncly image shrink photo.png --force
stderr '"code":"TERMINATED"'
exec bin/imageproof clean
rm marker
rm photo.shrunk.png

# R1-F6: the independent observer marks only a complete new destination.
# The ordinary scratch load makes cleanup observable, without a handler hook.
# spec: publication interrupted terminated staging
env STUB=slow-cleanup
protect photo.png
exec bin/imageproof published photo.png photo.shrunk.png marker &
survives photo.shrunk.png
signal INT marker ncly image shrink photo.png
stderr '"code":"INTERRUPTED"'
stderr '"output":.*photo[.]shrunk[.]png'
wait
exec bin/imageproof match photo.png photo.shrunk.png
exec bin/imageproof mode photo.shrunk.png 600
exec bin/imageproof clean
rm marker
rm photo.shrunk.png
cp photo.png photo.shrunk.png
chmod 640 photo.shrunk.png
protect photo.png
exec bin/imageproof published photo.png photo.shrunk.png marker &
survives photo.shrunk.png
signal TERM marker ncly image shrink photo.png --force
stderr '"code":"TERMINATED"'
stderr '"output":.*photo[.]shrunk[.]png'
wait
exec bin/imageproof match photo.png photo.shrunk.png
exec bin/imageproof mode photo.shrunk.png 640
exec bin/imageproof clean
rm marker
rm photo.shrunk.png
# A real cleanup error after link retains the complete copy and reports it.
# spec: publication publish-fails
env STUB=cleanup-fails
protect photo.png
keeps 1 ncly image shrink photo.png
stderr '"code":"IMAGE_SHRINK_PUBLISH"'
stderr '"output":.*photo[.]shrunk[.]png'
exec bin/imageproof match photo.png photo.shrunk.png
exec bin/imageproof repair-stage stage-path
exec bin/imageproof clean
rm photo.shrunk.png
env STUB=

# spec: invalid-result
env STUB=invalid
protect photo.png photo.shrunk.png
keeps 1 ncly image shrink photo.png
stderr '"code":"IMAGE_SHRINK_RESULT"'

