# All fixtures are generated here. The independent Go reader decodes every
# output pixel and checks color data and the private metadata block.
env GOTRACEBACK=none
exec go build -o bin/imageproof proof.go
exec bin/imageproof make
chmod 755 bin/vips

# spec: preview smaller format pixels privacy profile png-color alpha quality publication staging
symlink photo.shrunk.png.tmp -> photo.png
protect photo.png photo.shrunk.png.tmp
predicts ncly image shrink photo.png
reads -case 'Keeps private data of the input' -private 'Ana Lima' photo.shrunk.png reference photo.png bin/imageproof check 1
reads -case 'Keeps data that a reader needs' -private 'Montreal 45.5019' photo.shrunk.png reference photo.png bin/imageproof check 1
reads -case 'Loses data that changes the meaning' photo.shrunk.png reference photo.png bin/imageproof check 1
exec bin/imageproof clean

# The exact manifest example proves real byte saving and removal of its XMP.
# spec: pixels format smaller privacy profile alpha
ncly image shrink example.webp --json
reads example.shrunk.webp reference example.webp bin/imageproof check 1

# R1-F1: entire display-declaration family, not a single privacy payload.
# spec: privacy input-invalid png-color
exec bin/imageproof declarations
ncly image shrink valid-gAMA.png --json
exec bin/imageproof fixture valid-gAMA.png valid-gAMA.shrunk.png
protect length-gAMA.png length-gAMA.shrunk.png
refuses IMAGE_SHRINK_INPUT ncly image shrink length-gAMA.png
protect duplicate-gAMA.png duplicate-gAMA.shrunk.png
refuses IMAGE_SHRINK_INPUT ncly image shrink duplicate-gAMA.png
protect value-gAMA.png value-gAMA.shrunk.png
refuses IMAGE_SHRINK_INPUT ncly image shrink value-gAMA.png
ncly image shrink valid-cHRM.png --json
exec bin/imageproof fixture valid-cHRM.png valid-cHRM.shrunk.png
protect length-cHRM.png length-cHRM.shrunk.png
refuses IMAGE_SHRINK_INPUT ncly image shrink length-cHRM.png
protect duplicate-cHRM.png duplicate-cHRM.shrunk.png
refuses IMAGE_SHRINK_INPUT ncly image shrink duplicate-cHRM.png
protect value-cHRM.png value-cHRM.shrunk.png
refuses IMAGE_SHRINK_INPUT ncly image shrink value-cHRM.png
ncly image shrink valid-sRGB.png --json
exec bin/imageproof fixture valid-sRGB.png valid-sRGB.shrunk.png
protect length-sRGB.png length-sRGB.shrunk.png
refuses IMAGE_SHRINK_INPUT ncly image shrink length-sRGB.png
protect duplicate-sRGB.png duplicate-sRGB.shrunk.png
refuses IMAGE_SHRINK_INPUT ncly image shrink duplicate-sRGB.png
protect value-sRGB.png value-sRGB.shrunk.png
refuses IMAGE_SHRINK_INPUT ncly image shrink value-sRGB.png
ncly image shrink valid-cICP.png --json
exec bin/imageproof fixture valid-cICP.png valid-cICP.shrunk.png
protect length-cICP.png length-cICP.shrunk.png
refuses IMAGE_SHRINK_INPUT ncly image shrink length-cICP.png
protect duplicate-cICP.png duplicate-cICP.shrunk.png
refuses IMAGE_SHRINK_INPUT ncly image shrink duplicate-cICP.png
protect value-cICP.png value-cICP.shrunk.png
refuses IMAGE_SHRINK_INPUT ncly image shrink value-cICP.png
protect conflict-gamma.png conflict-gamma.shrunk.png
refuses IMAGE_SHRINK_INPUT ncly image shrink conflict-gamma.png
protect conflict-chroma.png conflict-chroma.shrunk.png
refuses IMAGE_SHRINK_INPUT ncly image shrink conflict-chroma.png
! exec bin/imageproof fixture valid-gAMA.png leaking-output.png
stderr 'invalid PNG display declaration'

# R1-F2: preserve Gray, Gray-alpha and CMYK sample models and profiles.
# spec: profile orientation pixels alpha depth
exec bin/imageproof model-fixtures
exec vips rawload gray-8-false.raw gray-8-false.v 64 32 1 --interpretation b-w
exec vips copy gray-8-false.v gray-8-false.png
exec bin/imageproof attach-model gray-8-false.png GRAY 2
ncly image shrink gray-8-false.png --json
exec bin/imageproof fixture gray-8-false.png gray-8-false.shrunk.png
rm gray-8-false.shrunk.png
ncly image shrink gray-8-false.png --max-side 32 --json
exec bin/imageproof fixture gray-8-false.png gray-8-false.shrunk.png 32
exec vips rawload gray-8-true.raw gray-8-true.v 64 32 2 --interpretation b-w
exec vips copy gray-8-true.v gray-8-true.png
exec bin/imageproof attach-model gray-8-true.png GRAY 2
ncly image shrink gray-8-true.png --json
exec bin/imageproof fixture gray-8-true.png gray-8-true.shrunk.png
rm gray-8-true.shrunk.png
ncly image shrink gray-8-true.png --max-side 32 --json
exec bin/imageproof fixture gray-8-true.png gray-8-true.shrunk.png 32
exec vips rawload gray-16-false.raw gray-16-false.v 64 32 1 --interpretation b-w --format ushort
exec vips copy gray-16-false.v gray-16-false.png
exec bin/imageproof attach-model gray-16-false.png GRAY 2
ncly image shrink gray-16-false.png --json
exec bin/imageproof fixture gray-16-false.png gray-16-false.shrunk.png
rm gray-16-false.shrunk.png
ncly image shrink gray-16-false.png --max-side 32 --json
exec bin/imageproof fixture gray-16-false.png gray-16-false.shrunk.png 32
exec vips rawload gray-16-true.raw gray-16-true.v 64 32 2 --interpretation b-w --format ushort
exec vips copy gray-16-true.v gray-16-true.png
exec bin/imageproof attach-model gray-16-true.png GRAY 2
ncly image shrink gray-16-true.png --json
exec bin/imageproof fixture gray-16-true.png gray-16-true.shrunk.png
rm gray-16-true.shrunk.png
ncly image shrink gray-16-true.png --max-side 32 --json
exec bin/imageproof fixture gray-16-true.png gray-16-true.shrunk.png 32
exec vips rawload cmyk.raw cmyk.v 64 32 4 --interpretation cmyk
exec vips copy cmyk.v 'cmyk.jpg[Q=100,keep=none]'
exec bin/imageproof attach-model cmyk.jpg CMYK 6
ncly image shrink cmyk.jpg --json
exec bin/imageproof fixture cmyk.jpg cmyk.shrunk.jpg
rm cmyk.shrunk.jpg
ncly image shrink cmyk.jpg --max-side 32 --json
exec bin/imageproof fixture cmyk.jpg cmyk.shrunk.jpg 32

# spec: exists
protect photo.png photo.shrunk.png
refuses IMAGE_SHRINK_EXISTS ncly image shrink photo.png

# spec: replace
protect photo.png
chmod 640 photo.shrunk.png
predicts ncly image shrink photo.png --force
exec bin/imageproof mode photo.shrunk.png 640
reads -case 'Exists, without --force' photo.shrunk.png reference photo.png bin/imageproof check 1

# All eight orientations carry a real TIFF orientation entry, ICC profile,
# private comment and non-symmetric colored quadrants.
# spec: orientation profile format pixels privacy
ncly image shrink orientation-1.jpg --json
reads orientation-1.shrunk.jpg reference orientation-1.jpg bin/imageproof check 1
ncly image shrink orientation-2.jpg --json
reads orientation-2.shrunk.jpg reference orientation-2.jpg bin/imageproof check 2
ncly image shrink orientation-3.jpg --json
reads orientation-3.shrunk.jpg reference orientation-3.jpg bin/imageproof check 3
ncly image shrink orientation-4.jpg --json
reads orientation-4.shrunk.jpg reference orientation-4.jpg bin/imageproof check 4
ncly image shrink orientation-5.jpg --json
reads orientation-5.shrunk.jpg reference orientation-5.jpg bin/imageproof check 5
ncly image shrink orientation-6.jpg --json
reads orientation-6.shrunk.jpg reference orientation-6.jpg bin/imageproof check 6
ncly image shrink orientation-7.jpg --json
reads orientation-7.shrunk.jpg reference orientation-7.jpg bin/imageproof check 7
ncly image shrink orientation-8.jpg --json
reads orientation-8.shrunk.jpg reference orientation-8.jpg bin/imageproof check 8

# The native PNG orientation path preserves unassociated alpha samples.
# spec: orientation pixels alpha
ncly image shrink png-orientation-1.png --json
reads png-orientation-1.shrunk.png reference png-orientation-1.png bin/imageproof check 1
ncly image shrink png-orientation-2.png --json
reads png-orientation-2.shrunk.png reference png-orientation-2.png bin/imageproof check 2
ncly image shrink png-orientation-3.png --json
reads png-orientation-3.shrunk.png reference png-orientation-3.png bin/imageproof check 3
ncly image shrink png-orientation-4.png --json
reads png-orientation-4.shrunk.png reference png-orientation-4.png bin/imageproof check 4
ncly image shrink png-orientation-5.png --json
reads png-orientation-5.shrunk.png reference png-orientation-5.png bin/imageproof check 5
ncly image shrink png-orientation-6.png --json
reads png-orientation-6.shrunk.png reference png-orientation-6.png bin/imageproof check 6
ncly image shrink png-orientation-7.png --json
reads png-orientation-7.shrunk.png reference png-orientation-7.png bin/imageproof check 7
ncly image shrink png-orientation-8.png --json
reads png-orientation-8.shrunk.png reference png-orientation-8.png bin/imageproof check 8

# Independent display-declaration cases without ICC overriding them.
# spec: png-color pixels privacy
ncly image shrink chroma.png --json
reads chroma.shrunk.png reference chroma.png bin/imageproof color chroma
ncly image shrink srgb.png --json
reads srgb.shrunk.png reference srgb.png bin/imageproof color srgb

# spec: depth
ncly image shrink deep.png --quality 1 --json
reads deep.shrunk.png reference deep.png bin/imageproof deep

# A lossless WebP fixture is generated with vips; Go's separate WebP decoder
# compares the lossy copy to the declared original quadrants and ICC bytes.
exec vips copy photo.png 'photo.webp[lossless,keep=icc]'
exec bin/imageproof private-webp photo.webp
# spec: alpha format quality pixels profile
ncly image shrink photo.webp --json
reads photo.shrunk.webp reference photo.webp bin/imageproof check 1

# spec: geometry
ncly image shrink large.png --json
reads large.shrunk.png reference large.png bin/imageproof check 1 '{}' 2048 1024
rm large.shrunk.png
ncly image shrink large.png --max-side 64 --json
reads large.shrunk.png reference large.png bin/imageproof check 1 '{}' 64 32

# spec: not-smaller
protect tiny.png tiny.shrunk.png
keeps 2 ncly image shrink tiny.png
stderr '"code":"IMAGE_SHRINK_NOT_SMALLER"'
! exists tiny.shrunk.png

# spec: input-invalid
exec bin/imageproof header
exec bin/imageproof animated
exec bin/imageproof huge
cp photo.png unreadable.png
cp unreadable.png readable-reference.png
chmod 000 unreadable.png
protect missing.png empty.png broken.png
refuses IMAGE_SHRINK_INPUT ncly image shrink missing.png
refuses IMAGE_SHRINK_INPUT ncly image shrink empty.png
refuses IMAGE_SHRINK_INPUT ncly image shrink broken.png
# Explicit accommodation for pascalandy/nicely#497: protect cannot hash a
# mode-000 file. Once fixed, remove the manual reference, mode check,
# restoration and cmp, and use protect unreadable.png again.
protect unreadable.shrunk.png
refuses IMAGE_SHRINK_INPUT ncly image shrink unreadable.png
exec bin/imageproof mode unreadable.png 0
chmod 600 unreadable.png
cmp unreadable.png readable-reference.png

# spec: unsupported
protect wrong.png wrong.gif wrong.jpg
refuses IMAGE_SHRINK_FORMAT ncly image shrink wrong.png
refuses IMAGE_SHRINK_FORMAT ncly image shrink wrong.gif
cp photo.png wrong.jpg
refuses IMAGE_SHRINK_FORMAT ncly image shrink wrong.jpg

# spec: budget
protect expansion.png expansion-pixels.png huge.png
refuses IMAGE_SHRINK_LIMIT ncly image shrink expansion.png
refuses IMAGE_SHRINK_LIMIT ncly image shrink expansion-pixels.png
refuses IMAGE_SHRINK_LIMIT ncly image shrink huge.png

# spec: multipart
protect animated.png
refuses IMAGE_SHRINK_MULTIPART ncly image shrink animated.png

# spec: options
exits 2 ncly image shrink photo.png --max-side 0 --json
exits 2 ncly image shrink photo.png --quality 101 --json
exits 2 ncly image shrink photo.png --timeout soon --json
exits 2 ncly image shrink photo.png --timeout 31s --json

# spec: output-link
rm photo.shrunk.png
symlink photo.shrunk.png -> photo.png
protect photo.png photo.shrunk.png
refuses IMAGE_SHRINK_OUTPUT ncly image shrink photo.png
refuses IMAGE_SHRINK_OUTPUT ncly image shrink photo.png --force
rm photo.shrunk.png
ncly image shrink photo.png --json
reads -case 'Is a link to the input' photo.shrunk.png reference photo.png bin/imageproof check 1
rm photo.shrunk.png
exec ln photo.png photo.shrunk.png
protect photo.png photo.shrunk.png
refuses IMAGE_SHRINK_OUTPUT ncly image shrink photo.png --force
rm photo.shrunk.png

# spec: names
cp photo.png 'my photo;$(date)[x].PNG'
ncly image shrink 'my photo;$(date)[x].PNG' --json
reads 'my photo;$(date)[x].shrunk.PNG' reference photo.png bin/imageproof check 1
cp photo.png -photo.png
ncly image shrink -- -photo.png
reads ./-photo.shrunk.png reference photo.png bin/imageproof check 1

# spec: staging publication
protect photo.png
env STUB=hold
holds marker photo.shrunk.png ncly image shrink photo.png
reads -case 'Temporary file' photo.shrunk.png reference photo.png bin/imageproof check 1
rm photo.shrunk.png

# spec: race
env STUB=appears
protect photo.png
appears marker photo.shrunk.png ncly image shrink photo.png
rm marker
rm photo.shrunk.png

# spec: worker-fails
env STUB=fail
protect photo.png photo.shrunk.png
keeps 1 ncly image shrink photo.png
stderr '"code":"RUNTIME"'
env STUB=noisy
protect photo.png
keeps 0 ncly image shrink photo.png
env STUB=fail
protect photo.png photo.shrunk.png
keeps 1 ncly image shrink photo.png --force
rm photo.shrunk.png
env STUB=hang
protect photo.png photo.shrunk.png
keeps 1 ncly image shrink photo.png --timeout 100ms
stderr '"code":"RUNTIME"'
rm marker

# spec: interrupted
env STUB=hang
protect photo.png photo.shrunk.png
signal INT marker ncly image shrink photo.png
stderr '"code":"INTERRUPTED"'
exec bin/imageproof clean
rm marker

# spec: terminated
cp photo.png photo.shrunk.png
env STUB=hang
protect photo.png photo.shrunk.png
signal TERM marker ncly image shrink photo.png --force
stderr '"code":"TERMINATED"'
exec bin/imageproof clean
rm marker
rm photo.shrunk.png

# spec: invalid-result
env STUB=invalid
protect photo.png photo.shrunk.png
keeps 1 ncly image shrink photo.png
stderr '"code":"IMAGE_SHRINK_RESULT"'

# A non-writable destination makes the publication failure observable on
# macOS too, where the Linux syscall-denial guard is unavailable.
# spec: publish-fails
env STUB=
mkdir locked
cp photo.png locked/photo.png
chmod 500 locked
protect locked/photo.png locked/photo.shrunk.png
keeps 1 ncly image shrink locked/photo.png
stderr '"code":"IMAGE_SHRINK_PUBLISH"'
chmod 700 locked
env STUB=
protect photo.png photo.shrunk.png
[linux] without link keeps 1 ncly image shrink photo.png
[linux] stderr '"code":"IMAGE_SHRINK_PUBLISH"'
ncly image shrink photo.png --json
protect photo.png photo.shrunk.png
[linux] without rename keeps 1 ncly image shrink photo.png --force
[linux] stderr '"code":"IMAGE_SHRINK_PUBLISH"'

# spec: no-vips
env STUB=old
protect photo.png
refuses PREREQ_MISSING ncly image shrink photo.png --force
env STUB=
rm bin/vips
env PATH=$WORK/bin
refuses PREREQ_MISSING ncly image shrink photo.png --force

