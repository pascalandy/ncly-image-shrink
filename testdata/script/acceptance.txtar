-- bin/vips --
#!/bin/sh
for real in /usr/bin/vips /opt/homebrew/bin/vips /usr/local/bin/vips; do
  if [ -x "$real" ]; then break; fi
done
case "$1:$STUB" in
--version:old) echo vips-1.0.0; exit 0 ;;
--version:*) exec "$real" --version ;;
esac
# Generation and command calls use the same real encoder unless a case stubs it.

target=${3%%\[*}
case "$STUB" in
lost-profile)
  "$real" "$@" || exit $?
  "$WORK/bin/imageproof" corrupt-display "$target" "$target" profile
  exit $?
  ;;
slow-cleanup)
  "$real" "$@" || exit $?
  "$WORK/bin/imageproof" cleanup-load "$target"
  exit $?
  ;;
cleanup-fails)
  "$real" "$@" || exit $?
  printf '%s' "${target%/*}" > "$WORK/stage-path"
  chmod 500 "${target%/*}"
  exit 0
  ;;
fail) exit 75 ;;
noisy) yes progress | head -c 2000000 ;;
hold)
  printf partial > "$target"
  echo ready > "$WORK/marker"
  while [ -e "$WORK/marker" ]; do sleep 0.01; done
  ;;
appears)
  echo ready > "$WORK/marker"
  while [ ! -e "$WORK/photo.shrunk.png" ]; do sleep 0.01; done
  ;;
hang)
  printf partial > "$target"
  echo ready > "$WORK/marker"
  exec sleep 30
  ;;
invalid) cp "$WORK/tiny.png" "$target"; exit 0 ;;
esac
exec "$real" "$@"
